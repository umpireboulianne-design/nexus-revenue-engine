  "components": {
    "schemas": {
      "AuditRequest": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Nom de domaine ou URL complète à auditer (ex: stripe.com ou https://shopify.com)"
          },
          "save_lead": {
            "type": "boolean",
            "title": "Save Lead",
            "description": "Enregistrer dans le pipeline de prospection B2B",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "AuditRequest"
      },
      "BatchAuditRequest": {
        "properties": {
          "urls": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Urls",
            "description": "Liste de domaines à scanner en parallèle (max 15 par lot)"
          }
        },
        "type": "object",
        "required": [
          "urls"
        ],
        "title": "BatchAuditRequest"
      },
      "CreateKeyRequest": {
        "properties": {
          "customer_email": {
            "type": "string",
            "title": "Customer Email",
            "description": "Email du client"
          },
          "plan": {
            "type": "string",
            "title": "Plan",
            "description": "Forfait (pro, agency, audit_forfait)",
            "default": "pro"
          },
          "monthly_quota": {
            "type": "integer",
            "title": "Monthly Quota",
            "description": "Quota mensuel d'appels API",
            "default": 5000
          },
          "mrr_usd": {
            "type": "number",
            "title": "Mrr Usd",
            "description": "Revenu mensuel récurrent associé en USD",
            "default": 29.0
          }
        },
        "type": "object",
        "required": [
          "customer_email"
        ],
        "title": "CreateKeyRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
